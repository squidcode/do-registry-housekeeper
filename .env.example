# DigitalOcean API Token (required)
# Create at: https://cloud.digitalocean.com/account/api/tokens
# Needs read/write access to Container Registry
DO_API_TOKEN=your_digitalocean_api_token_here

# Container Registry Name (required)
# This is the name of your DO Container Registry (not the full URL)
# Example: if your registry is registry.digitalocean.com/my-registry, use "my-registry"
DO_REGISTRY_NAME=your_registry_name

# Maximum number of tags to keep per repository (optional, default: 10)
# The function will keep the N most recent tags and remove older ones
MAX_TAGS_TO_KEEP=10

# Dry run mode (optional, default: false)
# Set to "true" to see what would be deleted without actually deleting
DRY_RUN=false
